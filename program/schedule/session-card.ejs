<%
const speakersFor = (item) => {
  if (!item.speaker) return [];
  const list = Array.isArray(item.speaker) ? item.speaker : [item.speaker];
  return list.filter((sp) => sp && sp.avatar_url);
};

const metaFields = ['time', 'speakerlist', 'room'];
%>

::: {.list .quarto-listing-default}

<% for (const item of items) { %>
<%
const speakers = speakersFor(item);
%>

::: {.quarto-post}

::: {.body}

<h3 class="no-anchor listing-title"><a href="<%- item.path %>" class="no-external"><%= item.title %></a></h3>

<% if (speakers.length > 0) { %>

```{=html}
<div class="thumbnail speaker-avatars"><a href="<%- item.path %>" class="no-external">
<% for (const speaker of speakers) { %>
<img src="<%- speaker.avatar_url %>" class="thumbnail-image" alt="<%= speaker.name ? speaker.name : '' %>" loading="lazy">
<% } %>
</a></div>
```

<% } %>

