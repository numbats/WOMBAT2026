```{=html}
<div class="person">
  <div class="card_columns">
    <% for (const item of items) { %>
      <div class="card">
        <img
          class="card-img-top"
          src="<%- item.thumbnail %>"
          alt="<%= item.name %> picture"
        >
        <div class="card-body">
          <h5 class="card_title"><%= item.name %></h5>
          <p class="card_text"><%= item.role %></p>
          <ul class="list_social">
            <% for (const tile of item.social) { %>
              <li class="icons_social">
                <% if (tile.website) { %>
                  <a class="social_link" href="<%- tile.website %>" aria-label="<%= item.name %> website">
                    <i class="bi bi-globe" aria-hidden="true"></i>
                  </a>
                <% } %>
                <% if (tile.github) { %>
                  <a class="social_link" href="<%- tile.github %>" aria-label="<%= item.name %> GitHub profile">
                    <i class="bi bi-github" aria-hidden="true"></i>
                  </a>
                <% } %>
                <% if (tile.twitter) { %>
                  <a class="social_link" href="<%- tile.twitter %>" aria-label="<%= item.name %> X profile">
                    <i class="bi bi-twitter" aria-hidden="true"></i>
                  </a>
                <% } %>
                <% if (tile.linkedin) { %>
                  <a class="social_link" href="<%- tile.linkedin %>" aria-label="<%= item.name %> LinkedIn profile">
                    <i class="bi bi-linkedin" aria-hidden="true"></i>
                  </a>
                <% } %>
                <% if (tile.facebook) { %>
                  <a class="social_link" href="<%- tile.facebook %>" aria-label="<%= item.name %> Facebook profile">
                    <i class="bi bi-facebook" aria-hidden="true"></i>
                  </a>
                <% } %>
                <% if (tile.mastodon) { %>
                  <a class="social_link" href="<%- tile.mastodon %>" aria-label="<%= item.name %> Mastodon profile">
                    <i class="bi bi-mastodon" aria-hidden="true"></i>
                  </a>
                <% } %>
                <% if (tile.bluesky) { %>
                  <a class="social_link" href="<%- tile.bluesky %>" aria-label="<%= item.name %> Bluesky profile">
                    <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" fill="currentColor" class="bi bi-bluesky" viewBox="0 0 16 16" aria-hidden="true">
                      <path d="M3.468 1.948C5.303 3.325 7.276 6.118 8 7.616c.725-1.498 2.698-4.29 4.532-5.668C13.855.955 16 .186 16 2.632c0 .489-.28 4.105-.444 4.692-.572 2.04-2.653 2.561-4.504 2.246 3.236.551 4.06 2.375 2.281 4.2-3.376 3.464-4.852-.87-5.23-1.98-.07-.204-.103-.3-.103-.218 0-.081-.033.014-.102.218-.379 1.11-1.855 5.444-5.231 1.98-1.778-1.825-.955-3.65 2.28-4.2-1.85.315-3.932-.205-4.503-2.246C.28 6.737 0 3.12 0 2.632 0 .186 2.145.955 3.468 1.948"/>
                    </svg>
                  </a>
                <% } %>
              </li>
            <% } %>
          </ul>
        </div>
      </div>
    <% } %>
  </div>
</div>
```