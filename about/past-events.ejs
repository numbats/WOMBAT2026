```{=html}
<div class="events">
  <div class="event_columns">
    <% for (const item of items) { %>
      <a
        class="event_card"
        href="<%- item.url %>"
        aria-label="WOMBAT <%= item.year %>: <%= item.theme %>"
      >
        <div class="event_card_year"><%= item.year %></div>
        <div class="event_card_body">
          <h3 class="event_card_theme"><%= item.theme %></h3>
          <ul class="event_card_meta">
            <li>
              <i class="bi bi-calendar3" aria-hidden="true"></i>
              <%= item.dates %>
            </li>
            <li>
              <i class="bi bi-geo-alt" aria-hidden="true"></i>
              <%= item.location %>
            </li>
          </ul>
          <span class="event_card_link">
            Visit site
            <i class="bi bi-arrow-right" aria-hidden="true"></i>
          </span>
        </div>
      </a>
    <% } %>
  </div>
</div>
```
